{
  "name": "adminpro-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AdminPro Tools — Smart Administrative Tools in One Place (Number to Words, Date Difference, Financial Calculator, Document Helper).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
